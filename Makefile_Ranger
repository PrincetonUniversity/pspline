# ============================================================================
# PSPLINE Makefile
#
# PPPL Ranger / GCC Toolset 13
#
# Supports:
#
#   MAKE_SO undefined or 0:
#       Build static library and test executables.
#
#   MAKE_SO=1:
#       Build static library, shared library, and test executables.
#
# Environment supplies machine-specific configuration.
#
# ============================================================================

SHELL := /bin/bash


# ============================================================================
# Compilers
# ============================================================================

FC  = gfortran
CC  = gcc
CXX = g++


# ============================================================================
# Archiver
# ============================================================================

AR      := ar
ARFLAGS := rcs


# ============================================================================
# Build configuration
# ============================================================================

MAKE_SO ?= 0


# ============================================================================
# NetCDF / HDF5
# ============================================================================

NETCDF_MODDIR ?= /usr/lib64/gfortran/modules
NETCDF_F_HOME ?= /usr
NETCDF_C_HOME ?= /usr
HDF5_HOME     ?= /usr

NETCDF_FLAGS := -D_NETCDF

FINCL := \
	-I$(NETCDF_MODDIR) \
	-I$(NETCDF_F_HOME)/include \
	-I$(NETCDF_C_HOME)/include \
	-I$(HDF5_HOME)/include


# ============================================================================
# External libraries
# ============================================================================

FLIBS := \
	-Wl,-rpath,$(NETCDF_F_HOME)/lib64 \
	-L$(NETCDF_F_HOME)/lib64 \
	-lnetcdff \
	-Wl,-rpath,$(NETCDF_C_HOME)/lib64 \
	-L$(NETCDF_C_HOME)/lib64 \
	-lnetcdf \
	-Wl,-rpath,$(HDF5_HOME)/lib64 \
	-L$(HDF5_HOME)/lib64 \
	-lhdf5_fortran \
	-lhdf5hl_fortran \
	-lhdf5_hl \
	-lhdf5

ifdef GCC_ROOT
FLIBS += \
	-Wl,-rpath,$(GCC_ROOT)/lib64 \
	-L$(GCC_ROOT)/lib64
endif

ifdef FLIBROOT
FLIBS += \
	-Wl,-rpath,$(FLIBROOT) \
	-L$(FLIBROOT) \
	-lgfortran \
	-lstdc++ \
	-lgcc_s
endif


# ============================================================================
# Compiler flags
# ============================================================================

FFLAGS ?= \
	-cpp \
	-O2 \
	-std=f2008 \
	-fdefault-real-8 \
	-fallow-argument-mismatch \
	-fallow-invalid-boz \
	-fno-range-check \
	-fdollar-ok

FFLAGS += $(NETCDF_FLAGS)

DFFLAGS := \
	-Og \
	-Wall \
	-fbacktrace \
	-fcheck=all \
	-ffpe-trap=invalid,zero,overflow

SFFLAGS ?= -fPIC

SLDFLAGS ?= -shared

LDFLAGS ?=

CXXFLAGS ?= -O2 -std=c++11

CXXFLAGS += $(NETCDF_FLAGS)

CXXLIBS := -lstdc++ -lgfortran


# ============================================================================
# Directories
# ============================================================================

SRCDIR := $(CURDIR)

PSPDIR := $(SRCDIR)/pspline
EZSDIR := $(SRCDIR)/ezspline
CZSDIR := $(SRCDIR)/czspline

PREFIX ?= $(SRCDIR)/build

LIBDIR := $(PREFIX)/lib
INCDIR := $(PREFIX)/include
TESTDR := $(PREFIX)/test


# ============================================================================
# Libraries
# ============================================================================

LIBAR := libpspline.a
LIBSO := libpspline.so


# ============================================================================
# Test executables
# ============================================================================

EXELUP := lookup_test
EXEPSP := pspltest
EXEQKS := qk_pspline
EXEEZS := ezspline_test
EXECZS := czspline_test


# ============================================================================
# Sources and objects
# ============================================================================

include source_dependency.mk

OBJS := $(SRCS:%.f90=%.o)

PICOBJS := $(SRCS:%.f90=%.pic.o)


# ============================================================================
# Build selection
# ============================================================================

ifeq ($(MAKE_SO),1)
BUILD_LIBS := $(LIBAR) $(LIBSO)
else
BUILD_LIBS := $(LIBAR)
endif

BUILD_TESTS := \
	$(EXELUP) \
	$(EXEPSP) \
	$(EXEQKS) \
	$(EXEEZS) \
	$(EXECZS)


# ============================================================================
# Fortran module compilation
#
# Prevent simultaneous normal/PIC compilation from writing the same .mod
# files.
# ============================================================================

.NOTPARALLEL:


# ============================================================================
# Targets
# ============================================================================

.PHONY: \
	all \
	show \
	clean \
	clobber \
	debug \
	install \
	shared \
	single \
	uninstall \
	tests


# ============================================================================
# Default build
# ============================================================================

all: $(BUILD_LIBS) $(BUILD_TESTS)


# ============================================================================
# Show configuration
# ============================================================================

show:
	@echo
	@echo "============================================================"
	@echo " PSPLINE build configuration"
	@echo "============================================================"
	@echo
	@echo "FC              = $(FC)"
	@echo "CC              = $(CC)"
	@echo "CXX             = $(CXX)"
	@echo
	@echo "MAKE_SO         = $(MAKE_SO)"
	@echo "PREFIX          = $(PREFIX)"
	@echo
	@echo "NETCDF_MODDIR   = $(NETCDF_MODDIR)"
	@echo "NETCDF_F_HOME   = $(NETCDF_F_HOME)"
	@echo "NETCDF_C_HOME   = $(NETCDF_C_HOME)"
	@echo "HDF5_HOME       = $(HDF5_HOME)"
	@echo
	@echo "FFLAGS          = $(FFLAGS)"
	@echo "CXXFLAGS        = $(CXXFLAGS)"
	@echo "SFFLAGS         = $(SFFLAGS)"
	@echo "SLDFLAGS        = $(SLDFLAGS)"
	@echo
	@echo "BUILD_LIBS      = $(BUILD_LIBS)"
	@echo "BUILD_TESTS     = $(BUILD_TESTS)"
	@echo
	@echo "============================================================"


# ============================================================================
# Static library
# ============================================================================

$(LIBAR): $(OBJS)
	@echo
	@echo "Building static library $(LIBAR)"
	$(AR) $(ARFLAGS) $@ $(OBJS)


# ============================================================================
# Shared library
# ============================================================================

shared: $(LIBSO)

$(LIBSO): $(PICOBJS)
	@echo
	@echo "Building shared library $(LIBSO)"
	$(FC) $(SLDFLAGS) \
		$(LDFLAGS) \
		-o $@ \
		$(PICOBJS) \
		$(FLIBS) \
		$(CXXLIBS)


# ============================================================================
# Test executables
# ============================================================================

$(EXELUP): $(LIBAR)
	$(FC) $(FFLAGS) \
		$(FINCL) \
		$(PSPDIR)/$@.f90 \
		-o $@ \
		-L$(SRCDIR) \
		-lpspline \
		$(FLIBS)

$(EXEPSP): $(LIBAR)
	$(FC) $(FFLAGS) \
		$(FINCL) \
		$(PSPDIR)/$@.f90 \
		-o $@ \
		-L$(SRCDIR) \
		-lpspline \
		$(FLIBS)

$(EXEQKS): $(LIBAR)
	$(FC) $(FFLAGS) \
		$(FINCL) \
		$(EZSDIR)/$@.f90 \
		-o $@ \
		-L$(SRCDIR) \
		-lpspline \
		$(FLIBS)

$(EXEEZS): $(LIBAR)
	$(FC) $(FFLAGS) \
		$(FINCL) \
		$(EZSDIR)/$@.f90 \
		-o $@ \
		-L$(SRCDIR) \
		-lpspline \
		$(FLIBS)

$(EXECZS): $(LIBAR)
	$(CXX) $(CXXFLAGS) \
		$(FINCL) \
		$(CZSDIR)/$@.cc \
		-o $@ \
		-L$(SRCDIR) \
		-lpspline \
		$(CXXLIBS) \
		$(FLIBS)


# ============================================================================
# Debug build
# ============================================================================

debug: FFLAGS += $(DFFLAGS)
debug: all


# ============================================================================
# Single precision build
# ============================================================================

single: FFLAGS += -D_SINGLE_PRECISION
single: all


# ============================================================================
# Module dependencies
# ============================================================================

include module_dependency.mk


# ============================================================================
# Normal object compilation
# ============================================================================

%.o: %.f90
	$(FC) \
		$(FFLAGS) \
		$(FINCL) \
		-c $< \
		-o $@


# ============================================================================
# PIC object compilation
# ============================================================================

%.pic.o: %.f90
	$(FC) \
		$(FFLAGS) \
		$(SFFLAGS) \
		$(FINCL) \
		-c $< \
		-o $@


# ============================================================================
# Tests
# ============================================================================

tests: $(BUILD_TESTS)


# ============================================================================
# Install
# ============================================================================

install: $(BUILD_LIBS)
	@echo
	@echo "Installing PSPLINE"
	@echo "PREFIX = $(PREFIX)"
	@echo

	@mkdir -p $(LIBDIR)
	@mkdir -p $(INCDIR)
	@mkdir -p $(TESTDR)

	@cp *.mod $(INCDIR)

	@cp $(CZSDIR)/czspline_capi.h $(INCDIR)

	@for lib in $(BUILD_LIBS); do \
		cp "$$lib" "$(LIBDIR)/"; \
	done

	@if [ -f $(PSPDIR)/pspltest.output ]; then \
		cp $(PSPDIR)/pspltest.output $(TESTDR); \
	fi

	@if [ -f $(PSPDIR)/lookup_test.output ]; then \
		cp $(PSPDIR)/lookup_test.output $(TESTDR); \
	fi

	@if [ -f $(EZSDIR)/ezspline_test.ref ]; then \
		cp $(EZSDIR)/ezspline_test.ref $(TESTDR); \
	fi

	@if [ -f $(EZSDIR)/qk_pspline.output ]; then \
		cp $(EZSDIR)/qk_pspline.output $(TESTDR); \
	fi

	@if [ -f $(CZSDIR)/czspline_test.output ]; then \
		cp $(CZSDIR)/czspline_test.output $(TESTDR); \
	fi

	@for exe in $(BUILD_TESTS); do \
		if [ -f "$$exe" ]; then \
			cp "$$exe" "$(TESTDR)/"; \
		fi; \
	done

	@echo
	@echo "Installed PSPLINE libraries:"
	@ls -lh $(LIBDIR)
	@echo


# ============================================================================
# Uninstall
# ============================================================================

uninstall:
	rm -rf $(PREFIX)


# ============================================================================
# Clean
# ============================================================================

clean:
	rm -f *~
	rm -f $(PSPDIR)/*~
	rm -f $(EZSDIR)/*~
	rm -f $(CZSDIR)/*~

	rm -f $(OBJS)
	rm -f $(PICOBJS)

	rm -f *.mod


# ============================================================================
# Full cleanup
# ============================================================================

clobber: clean
	rm -f $(LIBAR) $(LIBSO)
	rm -f $(EXELUP) $(EXEPSP) $(EXEQKS) $(EXEEZS) $(EXECZS)