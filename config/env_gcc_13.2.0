#!/bin/bash
#
# PSPLINE build environment
# PPPL Flux
# GCC 13.2.0 / OpenMPI 4.1.6
#

# ----------------------------------------------------------------------
# Start with a clean module environment
# ----------------------------------------------------------------------

module purge >/dev/null 2>&1

export PATH="/usr/bin:/bin:$PATH"
hash -r


# ----------------------------------------------------------------------
# Compiler
# ----------------------------------------------------------------------

module load gcc/13.2.0-gcc-11.4.1-wykjv >/dev/null 2>&1

export CC=gcc
export CXX=g++
export FC=gfortran
export F77=gfortran
export F90=gfortran

export COMPILER=gcc


# ----------------------------------------------------------------------
# MPI
# ----------------------------------------------------------------------

module load openmpi/4.1.6-gcc-13.2.0 >/dev/null 2>&1

export MPICC=mpicc
export MPICXX=mpicxx
export MPIFC=mpif90
export MPIF77=mpif77
export MPIF90=mpif90


# ----------------------------------------------------------------------
# NetCDF
# ----------------------------------------------------------------------

module load openmpi-4.1.6/gcc-13.2.0/netcdf-c/main-4adke \
    >/dev/null 2>&1

module load openmpi-4.1.6/gcc-13.2.0/netcdf-fortran/4.6.1-53pdx \
    >/dev/null 2>&1

module load libszip/2.1.1-gcc-13.2.0-wwyvk \
    >/dev/null 2>&1


# NetCDF preprocessor definition
export NETCDF_FLAGS="-D_NETCDF"


# NetCDF include directories
export I_NETCDF="\
-I${NETCDF_F_HOME}/include \
-I${NETCDF_C_HOME}/include"


# NetCDF libraries
#
# Keep netcdff before netcdf because the Fortran library depends
# on the NetCDF C library.
#
export L_NETCDF="\
-L${NETCDF_F_HOME}/lib -lnetcdff \
-L${NETCDF_C_HOME}/lib64 -lnetcdf"


# ----------------------------------------------------------------------
# HDF5
#
# NetCDF on Flux is built with HDF5 support. Do not load an unrelated
# hdf5-serial module on top of the OpenMPI/NetCDF dependency stack.
# ----------------------------------------------------------------------

if [[ -n "${HDF5_HOME:-}" ]]; then
    export I_HDF5="-I${HDF5_HOME}/include"
    export L_HDF5="\
-L${HDF5_HOME}/lib \
-lhdf5_fortran -lhdf5"
fi


# ----------------------------------------------------------------------
# SZIP
# ----------------------------------------------------------------------

if [[ -n "${SZIP_HOME:-}" ]]; then
    export I_SZIP="-I${SZIP_HOME}/include"
    export L_SZIP="-L${SZIP_HOME}/lib -lsz"
fi


# ----------------------------------------------------------------------
# Compiler flags
# ----------------------------------------------------------------------

export FFLAGS="-O2 -fPIC -fallow-argument-mismatch -fno-range-check"
export FCFLAGS="${FFLAGS}"

export CFLAGS="-O2 -fPIC"
export CXXFLAGS="-O2 -fPIC"


# ----------------------------------------------------------------------
# Shared-library runtime paths
# ----------------------------------------------------------------------

if [[ -n "${NETCDF_F_HOME:-}" ]]; then
    export LD_LIBRARY_PATH="${NETCDF_F_HOME}/lib:${LD_LIBRARY_PATH:-}"
fi

if [[ -n "${NETCDF_C_HOME:-}" ]]; then
    export LD_LIBRARY_PATH="${NETCDF_C_HOME}/lib64:${LD_LIBRARY_PATH:-}"
fi

if [[ -n "${HDF5_HOME:-}" ]]; then
    export LD_LIBRARY_PATH="${HDF5_HOME}/lib:${LD_LIBRARY_PATH:-}"
fi

if [[ -n "${SZIP_HOME:-}" ]]; then
    export LD_LIBRARY_PATH="${SZIP_HOME}/lib:${LD_LIBRARY_PATH:-}"
fi


# ----------------------------------------------------------------------
# Useful checks
# ----------------------------------------------------------------------

echo "------------------------------------------------------------"
echo "PSPLINE build environment: Flux"
echo "------------------------------------------------------------"
echo "CC             = $(command -v ${CC})"
echo "FC             = $(command -v ${FC})"
echo "MPICC          = $(command -v ${MPICC})"
echo "MPIF90         = $(command -v ${MPIF90})"
echo
echo "NETCDF_C_HOME  = ${NETCDF_C_HOME:-not set}"
echo "NETCDF_F_HOME  = ${NETCDF_F_HOME:-not set}"
echo "HDF5_HOME      = ${HDF5_HOME:-not set}"
echo "SZIP_HOME      = ${SZIP_HOME:-not set}"
echo
echo "NETCDF_FLAGS   = ${NETCDF_FLAGS}"
echo "I_NETCDF       = ${I_NETCDF}"
echo "L_NETCDF       = ${L_NETCDF}"
echo "------------------------------------------------------------"